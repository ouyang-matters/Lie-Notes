% --- Diamond Lattice Motif ---
% A pattern of small rotated squares (diamonds) suggesting
% algebraic structure and symmetry groups.
\renewcommand{\SeriesMotif}{%
  \begin{tikzpicture}[x=1pt, y=1pt]
    \foreach \i in {0,1,...,7} {
      \draw[lie-blue, opacity=0.2, line width=0.6pt, rotate=45]
        ({\i*13}, 0) rectangle ++(5,5);
    }
    \foreach \i in {0,1,...,6} {
      \draw[lie-sky, opacity=0.12, line width=0.5pt, rotate=45]
        ({\i*13+6.5}, 4) rectangle ++(4,4);
    }
  \end{tikzpicture}%
}

